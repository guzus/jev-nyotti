PORT=3000
DATA_DIR=.runtime
# Generate a random >=32-character key. Clients send Authorization: Bearer <key>.
API_KEY=
# Authenticated Qwen scoring service. See inference/README.md.
INFERENCE_URL=
INFERENCE_API_KEY=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
MODEL_ID=Qwen/Qwen3.5-4B
MODEL_REVISION=base
# base | fine_tuned | action_v1 (ACTION_V1: stateful 15m paper actions via POST {INFERENCE_URL}/action; needs a pinned MODEL_REVISION)
MODEL_TRAINING_STATUS=base
MAX_DAILY_EVALUATIONS=300
PUBLIC_REQUESTS_PER_MINUTE=6
INFERENCE_TIMEOUT_MS=120000
TRUST_PROXY_HOPS=0

# Opt-in automatic analysis: 10 displayed markets x 3 intervals, checked every 10 minutes.
# Set MAX_DAILY_EVALUATIONS=5000 in production when enabling this schedule.
SCHEDULED_ANALYSIS_ENABLED=false
# Optional Google Analytics 4 measurement ID (G- followed by uppercase alphanumerics).
GA_MEASUREMENT_ID=
